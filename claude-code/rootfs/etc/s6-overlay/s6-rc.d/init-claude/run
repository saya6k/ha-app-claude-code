#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# One-time setup before the terminal starts.
#
# Persistence layout (see DOCS.md):
#   /data/home      HOME — shell history, ~/.gitconfig, ~/.ssh (private)
#   /addon_config   CLAUDE_CONFIG_DIR — .claude.json, .credentials.json,
#                   settings.json, CLAUDE.md, sessions (user-editable)
# Both survive restarts and updates and are included in backups.
# ==============================================================================

mkdir -p "${HOME}" "${CLAUDE_CONFIG_DIR}" \
    || bashio::exit.nok "Failed to create ${HOME} / ${CLAUDE_CONFIG_DIR}"

# Seed default files that are missing. Existing files are never touched, so
# user edits (and a deleted file's replacement) always win.
for seed in /usr/share/claude-code/seed/* /usr/share/claude-code/seed/.[!.]*; do
    target="${CLAUDE_CONFIG_DIR}/$(basename "${seed}")"
    [ -e "${target}" ] && continue
    cp "${seed}" "${target}"
    bashio::log.info "Created default ${target}"
done
# Login tokens: owner-only, like Claude Code itself writes it.
chmod 600 "${CLAUDE_CONFIG_DIR}/.credentials.json"

# Optional long-lived token from `claude setup-token`. Written into the s6
# container environment so every with-contenv service (ttyd → tmux → claude)
# sees it. Never logged.
token_file=/run/s6/container_environment/CLAUDE_CODE_OAUTH_TOKEN
rm -f "${token_file}"
if bashio::config.has_value 'claude_code_oauth_token'; then
    printf '%s' "$(bashio::config 'claude_code_oauth_token')" > "${token_file}"
    chmod 600 "${token_file}"
    bashio::log.info 'Using claude_code_oauth_token from the app configuration'
elif jq -e '.claudeAiOauth' "${CLAUDE_CONFIG_DIR}/.credentials.json" >/dev/null 2>&1; then
    bashio::log.info "Using saved login from ${CLAUDE_CONFIG_DIR}/.credentials.json"
else
    bashio::log.info 'Not logged in yet — run /login in the terminal'
fi

# Code Mode (experimental): Claude Code reads CLAUDE_CODE_EXPERIMENTAL_CODE_MODE
# from the environment (1 = on). An explicit "0" in settings.json's env still
# turns it off, since Claude Code lets any "off" source win.
code_mode_file=/run/s6/container_environment/CLAUDE_CODE_EXPERIMENTAL_CODE_MODE
rm -f "${code_mode_file}"
if bashio::config.true 'experimental_code_mode'; then
    printf '1' > "${code_mode_file}"
    bashio::log.info 'Code Mode (experimental) enabled'
    if bashio::config.true 'enable_remote_control'; then
        bashio::log.warning 'Code Mode does not work with Remote Control; Claude Code starts with the ordinary tools. Turn off enable_remote_control to use Code Mode.'
    fi
fi

# settings.json entries the app manages: claudebar's statusLine and the
# restart-guard hook. Both are edited on a working copy that replaces the
# file only when something changed, and only the app's own entries are ever
# added or removed — a user's own statusLine or hooks are left alone.
settings="${CLAUDE_CONFIG_DIR}/settings.json"
work="${settings}.app-tmp"

edit() {  # edit JQ_FILTER [jq args...] — apply a filter to the working copy
    local filter=$1
    shift
    if jq "$@" "${filter}" "${work}" > "${work}.next" 2>/dev/null; then
        mv "${work}.next" "${work}"
    else
        # An unexpected shape (e.g. a string statusLine) must not stop the
        # app from starting: skip this one change.
        rm -f "${work}.next"
        bashio::log.warning "settings.json has an unexpected structure; a statusLine/hooks change was skipped"
    fi
}

if ! jq -e 'type == "object"' "${settings}" >/dev/null 2>&1; then
    bashio::log.warning "${settings} is not a valid JSON object; statusline and hooks not changed"
else
    cp "${settings}" "${work}"

    # claudebar statusline. The app options are the source of truth:
    # config.toml is regenerated on every start (edits made with
    # `claudebar config` do not survive a restart).
    if bashio::config.true 'statusline'; then
        cb_config="${XDG_CONFIG_HOME:-${HOME}/.config}/claudebar/config.toml"
        mkdir -p "$(dirname "${cb_config}")"
        segments=$(bashio::config 'statusline_segments' | jq -R . | jq -sc .)
        cat > "${cb_config}" <<TOML
# Generated from the Claude Code app options on every start — edit those.
theme = "$(bashio::config 'statusline_theme')"
style = "$(bashio::config 'statusline_style')"
segments = ${segments}

[thresholds]
warn = $(bashio::config 'statusline_warn')
crit = $(bashio::config 'statusline_crit')
weekly_show_at = $(bashio::config 'statusline_weekly_show_at')
TOML
        if jq -e '(.statusLine // null) == null or ((.statusLine.command // "") | startswith("claudebar"))' "${work}" >/dev/null; then
            edit '.statusLine = {"type": "command", "command": "claudebar render"}'
        else
            bashio::log.info "settings.json has its own statusLine; claudebar not wired in"
        fi
    else
        edit 'if ((.statusLine.command // "") | startswith("claudebar")) then del(.statusLine) else . end'
    fi

    # Restart guard: a PreToolUse hook on Bash that runs `ha core check`
    # before any Home Assistant restart and blocks it on an invalid config.
    # Always strip ours first, then re-add it when enabled.
    edit '
        if .hooks.PreToolUse then
            .hooks.PreToolUse |= map(
                if (.hooks | type) == "array" then
                    .hooks |= map(select(.command != "ha-restart-guard")) | select(.hooks | length > 0)
                else . end)
        else . end
        | if .hooks.PreToolUse == [] then del(.hooks.PreToolUse) else . end
        | if .hooks == {} then del(.hooks) else . end'
    if bashio::config.true 'restart_guard'; then
        edit '.hooks.PreToolUse += [{"matcher": "Bash", "hooks": [{"type": "command", "command": "ha-restart-guard", "timeout": 300}]}]'
    fi

    if cmp -s "${settings}" "${work}"; then
        rm -f "${work}"
    else
        mv "${work}" "${settings}"
        bashio::log.info "Updated statusLine/hooks in ${settings}"
    fi
fi

# Latest release on every start, or the pinned claude_code_version.
if bashio::config.has_value 'claude_code_version'; then
    bashio::log.info "Claude Code pinned to $(bashio::config 'claude_code_version')"
    claude-select "$(bashio::config 'claude_code_version')"
else
    claude-select
fi
